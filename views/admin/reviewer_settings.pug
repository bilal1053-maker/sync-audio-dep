extends layout.pug

append scripts
	script.
		function copyText(value, iconEl) {
			function done() {
				iconEl.classList.remove("bi-clipboard");
				iconEl.classList.add("bi-clipboard-check");
				setTimeout(function() {
					iconEl.classList.remove("bi-clipboard-check");
					iconEl.classList.add("bi-clipboard");
				}, 1500);
			}
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(value).then(done);
			} else {
				var textarea = document.createElement("textarea");
				textarea.value = value;
				document.body.appendChild(textarea);
				textarea.select();
				document.execCommand("copy");
				document.body.removeChild(textarea);
				done();
			}
		}
		document.addEventListener("DOMContentLoaded", function() {
			document.querySelectorAll(".icon-btn.copy").forEach(function(btn) {
				btn.addEventListener("click", function() {
					var value = btn.dataset.copyValue;
					if (value === undefined) {
						var input = document.getElementById(btn.dataset.for);
						value = input.value;
					}
					copyText(value, btn.querySelector("i"));
				});
			});
			var toggle = document.getElementById("toggle-password");
			var passwordInput = document.getElementById("password");
			if (toggle && passwordInput) {
				toggle.addEventListener("click", function() {
					var isHidden = passwordInput.type === "password";
					passwordInput.type = isHidden ? "text" : "password";
					var icon = toggle.querySelector("i");
					icon.classList.toggle("bi-eye", !isHidden);
					icon.classList.toggle("bi-eye-slash", isHidden);
				});
			}
			var notification = document.getElementById("save-notification");
			if (notification) {
				setTimeout(function() { notification.style.display = "none"; }, 3000);
			}
		});

append content
	style.
		.reviewer-settings-wrap {
			max-width: 560px;
			margin: 40px 0;
		}
		.reviewer-settings-wrap h1 {
			font-size: 20px;
			margin: 0 0 16px 0;
			color: #222;
		}
		.reviewer-link-row {
			display: flex;
			align-items: center;
			gap: 8px;
			margin-bottom: 28px;
		}
		.reviewer-link-row a {
			color: gray;
			font-size: 15px;
		}
		.reviewer-link-row .icon-btn {
			position: static;
			transform: none;
		}
		.settings-row {
			display: flex;
			align-items: center;
			margin-bottom: 20px;
		}
		.settings-row label {
			width: 150px;
			flex-shrink: 0;
			font-size: 14px;
			font-weight: 600;
			color: #333;
		}
		.field-group {
			position: relative;
			flex: 1;
		}
		.field-group input[type="text"],
		.field-group input[type="password"] {
			width: 100%;
			box-sizing: border-box;
			padding: 10px 44px 10px 12px;
			font-size: 14px;
			border: 1px solid #ddd;
			border-radius: 6px;
			background: #fafafa;
			transition: border-color 0.15s ease;
		}
		.field-group input:focus {
			outline: none;
			border-color: rgb(0,150,228);
			background: white;
		}
		.field-group.has-two-icons input {
			padding-right: 72px;
		}
		.icon-btn {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			background: none;
			border: none;
			cursor: pointer;
			padding: 6px;
			color: #888;
			font-size: 16px;
			line-height: 1;
		}
		.icon-btn:hover {
			color: rgb(0,150,228);
		}
		.icon-btn.copy { right: 8px; }
		.field-group.has-two-icons .icon-btn.toggle-eye { right: 40px; }
		.save-row {
			margin-top: 10px;
		}
		.save-row button[type="submit"] {
			padding: 8px 24px;
			font-size: 14px;
			font-weight: bold;
			color: white;
			background: rgb(0,150,228);
			border: none;
			border-radius: 6px;
			cursor: pointer;
		}
		.save-notification {
			max-width: 560px;
			margin: 0 0 16px 0;
			padding: 12px 16px;
			background: #e6f7f7;
			color: rgb(10,168,168);
			border: 1px solid rgb(10,168,168);
			border-radius: 8px;
			font-size: 14px;
			font-weight: bold;
			text-align: center;
		}

	if saved
		#save-notification.save-notification Username/Password updated
	if error
		.save-notification(style="background:#fdecea; color:#b3261e; border-color:#f5c6cb")= error

	.reviewer-settings-wrap
		h1 Reviewer Login Settings
		.reviewer-link-row
			a(href="https://sync-audio.com/reviewer", target="_blank") https://sync-audio.com/reviewer
			button.icon-btn.copy(type="button", data-copy-value="https://sync-audio.com/reviewer")
				i.bi.bi-clipboard
		form(action="/admin/reviewer-settings", method="post")
			.settings-row
				label(for="username") Username
				.field-group
					input(type="text", name="username", id="username", value=reviewer ? reviewer.username : "")
					button.icon-btn.copy(type="button", data-for="username")
						i.bi.bi-clipboard
			.settings-row
				label(for="password") Password
				.field-group.has-two-icons
					input(type="password", name="password", id="password", value=savedPassword ? savedPassword : "")
					button.icon-btn.toggle-eye(type="button", id="toggle-password")
						i.bi.bi-eye
					button.icon-btn.copy(type="button", data-for="password")
						i.bi.bi-clipboard
			.save-row
				button(type="submit") Save
