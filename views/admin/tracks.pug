extends layout.pug

block scripts
	script(src="/js/audio_upload.js")
	script(src="/js/genres.js")
	script(src="/js/moods.js")
	script(src="https://cdnjs.cloudflare.com/ajax/libs/fuse.js/3.0.4/fuse.min.js")
	script.
		function downloadSelectedTracks() {
			var ids = Array.prototype.slice.call(document.querySelectorAll(".track-select:checked")).map(function(el) { return el.value; });
			if (ids.length === 0) {
				return;
			}
			var format = document.getElementById("bulk-download-format").value;
			window.location = "/admin/tracks/download?ids=" + ids.join(",") + "&format=" + format;
		}
		document.addEventListener("DOMContentLoaded", function() {
			var downloadButton = document.getElementById("download-selected-button");
			var checkboxes = Array.prototype.slice.call(document.querySelectorAll(".track-select"));
			if (downloadButton && checkboxes.length > 0) {
				function updateDownloadButtonState() {
					var anyChecked = checkboxes.some(function(cb) { return cb.checked; });
					downloadButton.disabled = !anyChecked;
				}
				checkboxes.forEach(function(cb) {
					cb.addEventListener("change", updateDownloadButtonState);
				});
				updateDownloadButtonState();
			}

			var PAGE_SIZE = 50;
			var acceptedItems = Array.prototype.slice.call(document.querySelectorAll("#accepted-list .track-item"));
			var paginationContainer = document.getElementById("accepted-pagination");
			var paginationWrapper = document.getElementById("accepted-pagination-wrapper");
			var totalPages = Math.max(1, Math.ceil(acceptedItems.length / PAGE_SIZE));
			var currentPage = 1;

			function getPageNumbersToShow() {
				var pages = [];
				var windowSize = 2;
				for (var p = 1; p <= totalPages; p++) {
					if (p === 1 || p === totalPages || (p >= currentPage - windowSize && p <= currentPage + windowSize)) {
						pages.push(p);
					}
				}
				var result = [];
				var last = 0;
				pages.forEach(function(p) {
					if (last && p - last > 1) {
						result.push("...");
					}
					result.push(p);
					last = p;
				});
				return result;
			}

			function renderPaginationControls() {
				if (!paginationContainer) return;
				paginationContainer.innerHTML = "";
				paginationContainer.style.display = "flex";
				paginationContainer.style.alignItems = "center";
				paginationContainer.style.gap = "4px";

				function makeNumberLink(page) {
					var link = document.createElement("a");
					link.href = "javascript:void(0)";
					link.textContent = page;
					link.style.display = "inline-flex";
					link.style.alignItems = "center";
					link.style.justifyContent = "center";
					link.style.minWidth = "30px";
					link.style.height = "30px";
					link.style.borderRadius = "6px";
					link.style.fontSize = "13px";
					link.style.textDecoration = "none";
					if (page === currentPage) {
						link.style.background = "rgb(10,168,168)";
						link.style.color = "white";
						link.style.fontWeight = "bold";
					} else {
						link.style.color = "#333";
						link.style.background = "#f2f2f2";
						link.addEventListener("click", function() { showPage(page); });
						link.addEventListener("mouseenter", function() { if (page !== currentPage) link.style.background = "#e6f7f7"; });
						link.addEventListener("mouseleave", function() { if (page !== currentPage) link.style.background = "#f2f2f2"; });
					}
					return link;
				}

				var pageLabel = document.createElement("span");
				pageLabel.textContent = "Page";
				pageLabel.style.fontSize = "13px";
				pageLabel.style.color = "#555";
				pageLabel.style.fontWeight = "600";
				pageLabel.style.marginRight = "6px";
				paginationContainer.appendChild(pageLabel);

				getPageNumbersToShow().forEach(function(p) {
					if (p === "...") {
						var span = document.createElement("span");
						span.textContent = "...";
						span.style.padding = "0 4px";
						span.style.color = "#999";
						paginationContainer.appendChild(span);
					} else {
						paginationContainer.appendChild(makeNumberLink(p));
					}
				});
			}

			function showPage(page) {
				currentPage = page;
				var start = (page - 1) * PAGE_SIZE;
				var end = start + PAGE_SIZE;
				acceptedItems.forEach(function(li, i) {
					li.style.display = (i >= start && i < end) ? "" : "none";
				});
				renderPaginationControls();
			}

			if (acceptedItems.length > 0) {
				showPage(1);
			}

			var searchInput = document.getElementById("track-search");
			var allItems = Array.prototype.slice.call(document.querySelectorAll(".track-item"));
			if (searchInput) {
				searchInput.addEventListener("input", function() {
					var query = searchInput.value.trim().toLowerCase();
					if (query === "") {
						allItems.forEach(function(li) {
							li.style.display = acceptedItems.indexOf(li) === -1 ? "" : "none";
						});
						if (paginationWrapper) paginationWrapper.style.display = "flex";
						showPage(currentPage);
						return;
					}
					if (paginationWrapper) paginationWrapper.style.display = "none";
					allItems.forEach(function(li) {
						var text = (li.dataset.searchText || "").toLowerCase();
						li.style.display = text.indexOf(query) !== -1 ? "" : "none";
					});
				});
			}
		});

append content
	include ../upload.pug
	div(style="margin:24px 0 10px 0")
		p(style="margin:0 0 6px 0; font-size:15px; color:#555")
			strong Bulk Download:
			|  Select tracks below, choose a format, then click Download Selected.
		select#bulk-download-format(style="width:80px; height:22px; font-size:12px; padding:0 4px; margin-right:12px")
			option(value="wav", style="font-size:12px") WAV
			option(value="mp3", style="font-size:12px") MP3
		button#download-selected-button(type="button", onclick="downloadSelectedTracks()", disabled) Download Selected
	div(style="margin:24px 0 10px 0")
		p(style="margin:0 0 6px 0; font-size:15px; color:#000")
			strong Search Tracks
		input#track-search(type="text", placeholder="Search tracks by Title or Artist", style="width:320px; padding:6px; font-size:14px")
	if unreviewed.length > 0
		h1 Awaiting Review
		ul(style="padding-left:0; list-style-position:inside; column-count:2; column-gap:48px")
			for track in unreviewed
				li.track-item(data-search-text=track.title+" "+track.artist)
					a(href="/admin/tracks/"+track.id)= track.title+" by "+track.artist
						if track.stemCount > 0
							span(style="margin-left:8px; font-size:13px; color:rgb(10,168,168)") Stems: #{track.stemCount}
	if accepted.length > 0
		h1 Accepted
		ul#accepted-list(style="list-style:none; padding-left:0; column-count:2; column-gap:48px")
			for track, index in accepted
				li.track-item(data-search-text=track.title+" "+track.artist, style="display:flex; align-items:flex-start")
					span(style="flex-shrink:0; min-width:32px; text-align:right; margin-right:6px; color:#000; font-weight:bold; font-size:15px")= (index + 1) + "."
					input.track-select(type="checkbox", value=track.id, style="flex-shrink:0; margin-right:8px; margin-top:4px")
					span
						a(href="/admin/tracks/"+track.id)= track.title+" by "+track.artist
						if track.stemCount > 0
							span(style="margin-left:8px; font-size:13px; color:rgb(10,168,168)") Stems: #{track.stemCount}
		div#accepted-pagination-wrapper(style="margin-top:20px; padding:12px 16px; background:#fafafa; border:1px solid #eee; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-wrap:wrap")
			span#accepted-pagination
	if rejected.length > 0
		h1 Rejected
		ul(style="list-style:none; padding-left:0; column-count:2; column-gap:48px")
			for track in rejected
				li.track-item(data-search-text=track.title+" "+track.artist)
					input.track-select(type="checkbox", value=track.id, style="margin-right:8px")
					a(href="/admin/tracks/"+track.id)= track.title+" by "+track.artist
						if track.stemCount > 0
							span(style="margin-left:8px; font-size:13px; color:rgb(10,168,168)") Stems: #{track.stemCount}